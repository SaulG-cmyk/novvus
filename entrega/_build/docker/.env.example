# Copiar a .env y sustituir todos los valores antes de levantar la plataforma.
NOVVUS_VERSION=0.3.72
NOVVUS_REGISTRY=ghcr.io/novvus

POSTGRES_USER=novvus
POSTGRES_PASSWORD=cambiar-password-de-base-de-datos
POSTGRES_DB=novvus

# Generar cada secreto con: openssl rand -hex 32
NOVVUS_JWT_ACCESS_SECRET=cambiar-secreto-de-acceso-jwt
NOVVUS_JWT_REFRESH_SECRET=cambiar-secreto-de-refresco-jwt
NOVVUS_INTERNAL_HMAC_SECRET=cambiar-hmac-interno
NOVVUS_MODULE_DB_PASSWORD=cambiar-password-de-modulos
NOVVUS_BOOTSTRAP_TOKEN=cambiar-token-de-bootstrap

NOVVUS_WEB_PORT=8077
NOVVUS_LOG_LEVEL=info
NOVVUS_BRAND_ACCENT=
